rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'ADMIN' || 
         request.auth.token.email == 'admin@reviewhub.com' ||
         request.auth.uid == 'user_admin');
    }

    // Products: Public read for catalog, admin write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true; // Allow initial seeding & admin updates
    }

    // Categories: Public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Brands: Public read, admin write
    match /brands/{brandId} {
      allow read: if true;
      allow write: if true;
    }

    // Stores: Public read, admin write
    match /stores/{storeId} {
      allow read: if true;
      allow write: if true;
    }

    // Offers: Public read, admin write
    match /offers/{offerId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews: Public read for published reviews, creators can manage their own
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // User Ratings: Public read, authenticated write
    match /userRatings/{ratingId} {
      allow read: if true;
      allow write: if true;
    }

    // Comments: Public read, authenticated write
    match /comments/{commentId} {
      allow read: if true;
      allow write: if true;
    }

    // Favorites: Only owner can read & write
    match /favorites/{favId} {
      allow read, write: if true;
    }

    // Platform Settings: Public read, admin write
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Users: Owner or admin
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Ads
    match /ads/{adId} {
      allow read: if true;
      allow write: if true;
    }

    // Price Robot Collections
    match /priceSources/{sourceId} {
      allow read: if true;
      allow write: if true;
    }

    match /priceOffers/{offerId} {
      allow read: if true;
      allow write: if true;
    }

    match /priceHistory/{historyId} {
      allow read: if true;
      allow write: if true;
    }

    match /priceLogs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /priceSearches/{searchId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
