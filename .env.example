# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE CONFIGURATION (Vercel & Client-side)
# Adicione estas variáveis no painel da Vercel (Project Settings -> Environment Variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# SUPABASE CONFIGURATION (Price Robot & Cloud Database)
# Environment Secrets (Vercel & Platform)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Frontend / Public Anon Key (Vite Client-side)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend Only Service Role Key (NEVER expose to frontend or git)
SUPABASE_SERVICE_ROLE_KEY=

# MERCADO LIVRE API (Oficial - Backend Only)
MERCADOLIVRE_ACCESS_TOKEN=
